NODE_ENV=development
PORT=4101
SERVICE_NAME=auth-service
CORS_ORIGINS=http://localhost:4100,http://127.0.0.1:4100,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kiamina_auth

OTP_HASH_SECRET=replace_this_secret
OTP_EXPIRY_MINUTES=10
SMS_OTP_EXPIRY_MINUTES=5
SMS_OTP_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_TOKEN_SECRET=replace_this_auth_token_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_DOMAIN=
